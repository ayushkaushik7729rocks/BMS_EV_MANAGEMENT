# Copy to backend/.env for local development. Never use the demo threshold as a physical safety limit.
DATABASE_URL=sqlite:///./data/bms.sqlite3
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
DEVICE_ID=EVG-001
MOCK_TELEMETRY_ENABLED=true
MOCK_INTERVAL_SECONDS=5
MOCK_AUTO_CYCLE=true
MOCK_SCENARIO_SECONDS=60
MOCK_SCENARIO=NORMAL
# Development-only carry-forward from the existing UI mock. Replace with the cell maker's documented limit before hardware use.
THERMAL_THRESHOLD_C=55.0
COOLING_ACTIVATION_C=34.0
